PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventhub?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI chatbot (Google Gemini) - create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
#copy a current Flash model name from Google AI Studio
GEMINI_MODEL=gemini-3.5-flash-lite

# Email notifications (booking confirmation, cancellations, reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=EventHub <your-address@example.com>

APP_URL=

REMINDERS_ENABLED=true

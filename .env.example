PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventhub?retryWrites=true&w=majority
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# AI chatbot (Google Gemini) - create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# If this model name stops working, copy a current Flash model name from Google AI Studio
GEMINI_MODEL=gemini-3.5-flash-lite
